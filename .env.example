# ── Firebase ──────────────────────────────────────────────
# Path to the Firebase Admin SDK service-account JSON key.
# NEVER commit the real file. Download it from:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-admin.json
FIREBASE_PROJECT_ID=pixora-main-data
FIREBASE_DATABASE_URL=https://pixora-main-data-default-rtdb.firebaseio.com
# Which Firebase product holds training data: "firestore" or "rtdb"
FIREBASE_DATA_BACKEND=firestore
FIREBASE_TRAINING_COLLECTION=training_examples

# ── Model / Training ──────────────────────────────────────
MODEL_NAME=pixora
MODEL_DIR=./models/pixora
DATASET_DIR=./dataset
TOKENIZER_DIR=./models/pixora/tokenizer

# "finetune" -> start from an open-weight base model (Mode A, recommended first)
# "scratch"  -> randomly initialized Pixora transformer (Mode B, research)
TRAINING_MODE=finetune
BASE_MODEL_NAME=Qwen/Qwen2.5-0.5B

VOCAB_SIZE=32000
HIDDEN_SIZE=768
NUM_LAYERS=12
NUM_ATTENTION_HEADS=12
MAX_SEQUENCE_LENGTH=1024

BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=8
LEARNING_RATE=2e-5
EPOCHS=3
WARMUP_STEPS=100
SAVE_EVERY_STEPS=500
MIXED_PRECISION=bf16

# ── Inference server ──────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
MAX_NEW_TOKENS=512
TEMPERATURE=0.7
